# Скопируй в apps/web/.env и подставь свои значения. Реальные секреты не коммить.
# NEXT_PUBLIC_* попадают в браузер: ничего секретного в них не клади.

# --- Auth (next-auth 5) ---
# Должен совпадать с AUTH_SECRET (или NEXTAUTH_SECRET) в apps/api/.env. Сгенерируй: openssl rand -base64 48
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-48

# Домен cookie сессии (например .myapp.local, чтобы её видел и api за nginx). Пусто: host-only, работает на localhost
AUTH_COOKIE_DOMAIN=

# --- URL API (см. apps/web/api.ts) ---
# Для браузера: через nginx
NEXT_PUBLIC_API_CLIENT_URL=http://myapp.local/api
# Для серверных компонентов: напрямую в контейнер api (docker compose) или http://localhost:3001 при запуске без docker
NEXT_PUBLIC_API_SERVER_URL=http://api:3001

# --- Stripe (публичный ключ pk_test_...) ---
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# --- Капча ---
NEXT_PUBLIC_GOOGLE_CAPTCHA_PUBLIC_KEY=
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=

# --- Аналитика и feature flags (необязательно) ---
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_GROWTHBOOK_API_HOST=
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# --- Внутренний секрет web → api ---
# Только сервер (НЕ NEXT_PUBLIC_*), >= 32 символов, должен совпадать с INTERNAL_API_SECRET в apps/api/.env. Сгенерируй: openssl rand -base64 48
INTERNAL_API_SECRET=change-me-generate-with-openssl-rand-base64-48
