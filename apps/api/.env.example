# Скопируй в apps/api/.env и подставь свои значения. Реальные секреты не коммить.
# Список собран из кода apps/api (config/, modules/*). Обязательные помечены (*).

# --- Приложение ---
NODE_ENV=development
# (*) порт, на котором слушает Nest (main.ts бросает ошибку, если не задан). Nginx проксирует /api/ на api:3001.
SERVER_PORT=3001
# Порт из Joi-схемы config/validation.ts (по умолчанию 3000). Сейчас код слушает SERVER_PORT, не PORT.
PORT=3001
# (*) URL фронтенда: CORS origin и ссылки в письмах и оплате
CLIENT_URL=http://myapp.local

# --- Аутентификация ---
# (*) минимум 32 символа (Joi-валидация). Сгенерируй: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# JwtAuthGuard проверяет токены от web ключом AUTH_SECRET или NEXTAUTH_SECRET:
# значение должно совпадать с NEXTAUTH_SECRET в apps/web/.env
AUTH_SECRET=change-me-same-as-web-nextauth-secret

# (*) в production: общий секрет web -> api, минимум 32 символа. Web шлёт его в заголовке X-Internal-Secret
# (validate, SSR) и IP клиента в X-Client-IP; то же значение в apps/web/.env. Только на сервере, не NEXT_PUBLIC_*.
# Вне production без него validate открыт (локальная разработка), X-Client-IP не принимается.
# Сгенерируй: openssl rand -base64 48
INTERNAL_API_SECRET=
# Сколько прокси перед api доверяем для X-Forwarded-For (по умолчанию 1 хоп: nginx на краю). `false` отключает.
# TRUST_PROXY=1

# --- База данных, кэш, очереди (значения по умолчанию из docker-compose.yml) ---
# (*)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# (*)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# (*) без значения по умолчанию
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/
# Очереди BullMQ (письма, платежи, PDF) используют тот же REDIS_URL

# --- Stripe (тестовые ключи sk_test_..., webhook secret из `stripe listen`) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Вебхук: POST /billing/webhook; события ставятся в очередь, дубли по event.id отбрасываются (Redis, 7 дней)

# --- Хранилище S3 (все четыре нужны, иначе S3StorageService не стартует) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Необязательно, для Cloudflare R2 (AWS_REGION=auto): адрес S3 API и публичный адрес бакета.
# Без них используется AWS S3 и ссылка https://<bucket>.s3.<region>.amazonaws.com/...
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_PUBLIC_URL=https://files.example.com

# --- Почта (письма уходят через очередь BullMQ, нужен ключ выбранного провайдера) ---
# Провайдер: sendgrid (по умолчанию) или resend
EMAIL_PROVIDER=sendgrid
# (*) в production: адрес отправителя, подтверждённый у провайдера, например `App <noreply@example.com>`
EMAIL_FROM=
# Секрет токенов подтверждения почты, минимум 32 символа. Без него берётся производный от JWT_SECRET.
# Сгенерируй: openssl rand -base64 48
EMAIL_VERIFICATION_SECRET=
SENDGRID_API_KEY=
RESEND_API_KEY=

# --- SMS (Twilio Verify) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Платная отправка SMS включается только значением `enabled` (twilio.service.ts): на проде должно быть `enabled`.
PAID_API=false
# Dev-мок: при PAID_API != enabled и SMS_DEV_MOCK=true SMS не уходит, а код входа всегда 123456.
# Без флага при PAID_API != enabled отправка падает (503), код не проверяется. В production запрещён (Joi).
SMS_DEV_MOCK=true
# Глобальный суточный потолок отправок SMS (расходы Twilio), по умолчанию 1000. Лимиты на номер и пользователя: 5 в час.
SMS_DAILY_LIMIT=1000

# --- Капча ---
GOOGLE_CAPTCHA_SECRET_KEY=
