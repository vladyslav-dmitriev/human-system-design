# Скопируй в apps/api/.env и подставь свои значения. Реальные секреты не коммить.
# Список собран из кода apps/api (config/, modules/*). Обязательные помечены (*).

# --- Приложение ---
NODE_ENV=development
# (*) порт, на котором слушает Nest (main.ts бросает ошибку, если не задан). Nginx проксирует /api/ на api:3001.
SERVER_PORT=3001
# Порт из Joi-схемы config/validation.ts (по умолчанию 3000). Сейчас код слушает SERVER_PORT, не PORT.
PORT=3001
# (*) URL фронтенда: CORS origin и ссылки в письмах и оплате
CLIENT_URL=http://myapp.local

# --- Аутентификация ---
# (*) минимум 32 символа (Joi-валидация). Сгенерируй: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# JwtAuthGuard проверяет токены от web ключом AUTH_SECRET или NEXTAUTH_SECRET:
# значение должно совпадать с NEXTAUTH_SECRET в apps/web/.env
AUTH_SECRET=change-me-same-as-web-nextauth-secret

# --- База данных, кэш, очереди (значения по умолчанию из docker-compose.yml) ---
# (*)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# (*)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
RABBITMQ_URL=amqp://admin:admin123@localhost:5672/

# --- Stripe (тестовые ключи sk_test_..., webhook secret из `stripe listen`) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Хранилище S3 (все четыре нужны, иначе S3StorageService не стартует) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# --- Почта (нужен ключ выбранного провайдера) ---
SENDGRID_API_KEY=
RESEND_API_KEY=

# --- SMS (Twilio Verify) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Платная отправка SMS включается только значением `enabled` (twilio.service.ts). При любом другом значении
# SMS не отправляется, а проверка кода всегда проходит: на проде должно быть `enabled`.
PAID_API=false

# --- Капча ---
GOOGLE_CAPTCHA_SECRET_KEY=
