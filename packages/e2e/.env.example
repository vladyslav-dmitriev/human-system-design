# Copy to packages/e2e/.env and fill in. Do NOT commit the .env file.
# Dedicated TEST account only. Never use a real personal account.
# Register it once via /en/create-account, e.g. qa-e2e-<timestamp>@example.test
E2E_USER_EMAIL=qa-e2e-<timestamp>@example.test
E2E_USER_PASSWORD=<generated-password>

# Optional, defaults to http://myapp.local
# E2E_BASE_URL=http://myapp.local
