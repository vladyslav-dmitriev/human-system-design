{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "i18n:upload": "pnpm exec crowdin upload sources",
    "i18n:download": "pnpm exec crowdin download",
    "i18n:sync": "pnpm exec crowdin upload sources && crowdin download",
    "k8s:up": "bash infra/scripts/local-up.sh",
    "k8s:deploy": "bash infra/scripts/local-up.sh",
    "k8s:secrets": "bash infra/scripts/local-secrets.sh",
    "k8s:check": "bash infra/scripts/local-check.sh",
    "k8s:proxy": "bash infra/scripts/local-proxy.sh",
    "k8s:down": "bash infra/scripts/local-down.sh",
    "test:e2e": "pnpm --filter web build && pnpm --filter e2e exec playwright test",
    "test:e2e:ui": "pnpm --filter web build && pnpm --filter e2e exec playwright test --ui"
  },
  "devDependencies": {
    "@crowdin/cli": "^4.14.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.2",
      "form-data": "^4.0.6",
      "proxy-addr": "^2.0.8",
      "express@5>body-parser": "^2.4.0",
      "ws@8": "^8.21.0",
      "engine.io": "^6.6.10",
      "socket.io-parser": "^4.2.7",
      "source-map-js": "^1.2.2",
      "fast-uri": "^3.1.7",
      "effect": "^3.22.1",
      "mysql2": "^3.22.0",
      "browserslist": "^4.28.7",
      "deepmerge-ts": "^8.0.0"
    }
  }
}
